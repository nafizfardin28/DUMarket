# App
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (used directly by Prisma)
DATABASE_URL=postgresql://dumarket_user:devpassword@localhost:5432/dumarket?schema=public

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Restrict signups to this email domain (and its department subdomains)
ALLOWED_STUDENT_EMAIL_DOMAIN=du.ac.bd

# Email (SMTP). Leave EMAIL_HOST_USER/PASSWORD blank to just log emails to
# the console instead of sending them.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DUMarket <no-reply@dumarket.local>
